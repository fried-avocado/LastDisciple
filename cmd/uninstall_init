#!/bin/bash

LOG_FILE="${TRIM_TEMP_LOGFILE:-${TRIM_PKGVAR}/info.log}"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >>"${LOG_FILE}"
}

### This script is called before the user uninstalls the application.
### Stop the running process gracefully before uninstall.

log_msg "Stopping ${TRIM_APPNAME:-LastDisciple} before uninstall..."

PID_FILE="${TRIM_PKGVAR}/app.pid"

if [ -f "${PID_FILE}" ]; then
  pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
  if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
    log_msg "Stopping process PID:${pid}..."
    kill -TERM "${pid}" 2>/dev/null
    count=0
    while kill -0 "${pid}" 2>/dev/null && [ $count -lt 30 ]; do
      sleep 1
      count=$((count + 1))
    done
    if kill -0 "${pid}" 2>/dev/null; then
      log_msg "Process did not stop gracefully, sending KILL signal..."
      kill -KILL "${pid}" 2>/dev/null
    fi
    rm -f "${PID_FILE}"
    log_msg "Process stopped."
  fi
else
  log_msg "No running process found (pid file not present)."
fi

exit 0