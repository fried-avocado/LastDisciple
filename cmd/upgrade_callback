#!/bin/bash

LOG_FILE="${TRIM_TEMP_LOGFILE:-${TRIM_PKGVAR}/info.log}"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >>"${LOG_FILE}"
}

APP_SRC_DIR="${TRIM_APPDEST}/server"

log_msg "Starting upgrade for ${TRIM_APPNAME:-LastDisciple} ${TRIM_APPVER:-1.0.0}"
log_msg "App directory: ${TRIM_APPDEST}"
log_msg "Data directory: ${TRIM_PKGVAR}"

# 应用为纯 Python 标准库实现，无第三方依赖，不再创建 venv；
# 这里清理旧版本遗留的 venv 目录
if [ -n "${TRIM_PKGVAR}" ] && [ -d "${TRIM_PKGVAR}/.venv" ]; then
  log_msg "Removing legacy venv: ${TRIM_PKGVAR}/.venv"
  rm -rf "${TRIM_PKGVAR}/.venv"
fi
if [ -n "${APP_SRC_DIR}" ] && [ -d "${APP_SRC_DIR}/.venv" ]; then
  log_msg "Removing legacy venv: ${APP_SRC_DIR}/.venv"
  rm -rf "${APP_SRC_DIR}/.venv"
  rm -f "${APP_SRC_DIR}/.venv_migrated"
fi

mkdir -p "${TRIM_PKGVAR}"
mkdir -p "${TRIM_PKGVAR}/logs"

log_msg "Upgrade completed successfully."
exit 0
